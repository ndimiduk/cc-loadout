#!/usr/bin/env python3
"""Show a sparkline of recent usage across supported coding agents.

Usage:
    agent-usage-spark
    agent-usage-spark              # estimated cost
    agent-usage-spark --tokens     # input + output token total
    agent-usage-spark --days 30

The default output is suitable for tmux status-right.
"""

from __future__ import annotations

import fcntl
import json
import os
import ssl
import sys
import tempfile
import time
import urllib.request
from datetime import datetime
from pathlib import Path

SPARK_CHARS = "▁▂▃▄▅▆▇█"
CACHE_DIR = Path.home() / ".cache" / "agent-usage-spark"

PRICING_CACHE = CACHE_DIR / "litellm-pricing.json"
PRICING_URL = "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json"
PRICING_MAX_AGE = 86400
DEFAULT_DAYS = 30
WEEKS = 12


def parse_timestamp(value: object) -> float | None:
    if isinstance(value, (int, float)):
        return float(value) / 1000 if value > 10_000_000_000 else float(value)
    if isinstance(value, str):
        try:
            return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
        except ValueError:
            return None
    return None


def add_usage(target: dict[str, int], usage: dict, *, pi_format: bool) -> None:
    if pi_format:
        target["input_tokens"] += usage.get("input", 0)
        target["output_tokens"] += usage.get("output", 0)
        target["cache_read_tokens"] += usage.get("cacheRead", 0)
        target["cache_creation_tokens"] += usage.get("cacheWrite", 0)
    else:
        target["input_tokens"] += usage.get("input_tokens", 0)
        target["output_tokens"] += usage.get("output_tokens", 0)
        target["cache_read_tokens"] += usage.get("cache_read_input_tokens", 0)
        target["cache_creation_tokens"] += usage.get("cache_creation_input_tokens", 0)


def record_size(record: dict) -> int:
    return sum(
        record[key]
        for key in (
            "input_tokens",
            "output_tokens",
            "cache_read_tokens",
            "cache_creation_tokens",
        )
    )


def parse_session(path: Path, agent: str) -> list[dict]:
    is_pi = agent == "pi"
    records_by_id: dict[str, dict] = {}
    records_without_id = []

    try:
        with path.open() as session_file:
            for line in session_file:
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                expected_type = "message" if is_pi else "assistant"
                if entry.get("type") != expected_type:
                    continue
                message = entry.get("message", {})
                if is_pi and message.get("role") != "assistant":
                    continue
                usage = message.get("usage", {})
                if not usage:
                    continue
                message_id = entry.get("id") or message.get("id")
                totals = {
                    "input_tokens": 0,
                    "output_tokens": 0,
                    "cache_read_tokens": 0,
                    "cache_creation_tokens": 0,
                }
                add_usage(totals, usage, pi_format=is_pi)
                if not any(totals.values()):
                    continue
                timestamp = parse_timestamp(entry.get("timestamp"))
                if timestamp is None:
                    timestamp = path.stat().st_mtime
                cost_known = False
                cost = 0.0
                if is_pi:
                    cost_record = usage.get("cost")
                    reported_cost = cost_record.get("total") if isinstance(cost_record, dict) else None
                    cost_known = isinstance(reported_cost, (int, float))
                    cost = reported_cost if cost_known else 0.0
                record = {
                    "agent": agent,
                    "record_id": message_id,
                    "session_id": path.stem,
                    "path": str(path),
                    "timestamp": timestamp,
                    "model": message.get("model", ""),
                    "cost_usd": cost,
                    "cost_known": cost_known,
                    **totals,
                }
                if message_id:
                    previous = records_by_id.get(message_id)
                    if previous is None or record_size(record) >= record_size(previous):
                        records_by_id[message_id] = record
                else:
                    records_without_id.append(record)
    except OSError:
        return []

    return list(records_by_id.values()) + records_without_id


def session_paths() -> list[tuple[str, Path]]:
    paths: list[tuple[str, Path]] = []
    claude_root = Path.home() / ".claude" / "projects"
    if claude_root.exists():
        paths.extend(("claude", path) for path in claude_root.rglob("*.jsonl"))

    pi_root = Path.home() / ".pi" / "agent" / "sessions"
    if pi_root.exists():
        paths.extend(("pi", path) for path in pi_root.rglob("*.jsonl"))
    return paths


def entries_from_cache(file_cache: dict, days: int) -> list[dict]:
    cutoff = time.time() - days * 86400
    entries_by_key: dict[tuple[str, str], dict] = {}
    entries_without_id = []
    for cached in file_cache.values():
        for entry in cached.get("records", []):
            if entry["timestamp"] < cutoff:
                continue
            agent = entry["agent"]
            record_id = entry.get("record_id")
            record_key = (agent, record_id) if record_id else None
            if record_key:
                previous = entries_by_key.get(record_key)
                if previous is None or record_size(entry) >= record_size(previous):
                    entries_by_key[record_key] = entry
            else:
                entries_without_id.append(entry)
    return list(entries_by_key.values()) + entries_without_id


def load_sessions(days: int) -> list[dict]:
    file_cache_path = CACHE_DIR / "files-v1.json"
    lock_path = CACHE_DIR / "files-v1.lock"
    try:
        file_cache = json.loads(file_cache_path.read_text()) if file_cache_path.exists() else {}
    except (OSError, json.JSONDecodeError):
        file_cache = {}

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    with lock_path.open("w") as lock_file:
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return entries_from_cache(file_cache, days)

        try:
            try:
                file_cache = json.loads(file_cache_path.read_text()) if file_cache_path.exists() else {}
            except (OSError, json.JSONDecodeError):
                file_cache = {}

            current_cache = {}
            for agent, path in session_paths():
                path_key = f"{agent}:{path}"
                try:
                    stat = path.stat()
                except OSError:
                    continue
                signature = {"mtime_ns": stat.st_mtime_ns, "size": stat.st_size}
                cached = file_cache.get(path_key)
                if cached and cached.get("signature") == signature:
                    records = cached.get("records", [])
                else:
                    records = parse_session(path, agent)
                current_cache[path_key] = {"signature": signature, "records": records}

            temporary_file = tempfile.NamedTemporaryFile(
                mode="w",
                dir=CACHE_DIR,
                prefix="files-v1-",
                suffix=".tmp",
                delete=False,
            )
            temporary_path = Path(temporary_file.name)
            try:
                json.dump(current_cache, temporary_file)
                temporary_file.close()
                os.replace(temporary_path, file_cache_path)
            except OSError:
                temporary_file.close()
                temporary_path.unlink(missing_ok=True)
            return entries_from_cache(current_cache, days)
        finally:
            fcntl.flock(lock_file, fcntl.LOCK_UN)


def load_pricing() -> dict:
    if PRICING_CACHE.exists() and time.time() - PRICING_CACHE.stat().st_mtime < PRICING_MAX_AGE:
        try:
            return json.loads(PRICING_CACHE.read_text())
        except (OSError, json.JSONDecodeError):
            pass
    try:
        request = urllib.request.Request(PRICING_URL, headers={"User-Agent": "agent-usage-spark/1.0"})
        with urllib.request.urlopen(request, timeout=10, context=ssl.create_default_context()) as response:
            pricing = json.loads(response.read())
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        PRICING_CACHE.write_text(json.dumps(pricing))
        return pricing
    except (OSError, ValueError):
        if PRICING_CACHE.exists():
            try:
                return json.loads(PRICING_CACHE.read_text())
            except (OSError, json.JSONDecodeError):
                pass
        return {}


def claude_cost(pricing: dict, entry: dict) -> float | None:
    model_pricing = pricing.get(entry.get("model", ""))
    if not model_pricing:
        return None
    components = (
        ("input_tokens", "input_cost_per_token"),
        ("output_tokens", "output_cost_per_token"),
        ("cache_read_tokens", "cache_read_input_token_cost"),
        ("cache_creation_tokens", "cache_creation_input_token_cost"),
    )
    for token_key, price_key in components:
        if entry[token_key] and not isinstance(model_pricing.get(price_key), (int, float)):
            return None
    return sum(entry[token_key] * model_pricing.get(price_key, 0) for token_key, price_key in components)


def sparkline(values: list[float]) -> str:
    maximum = max(values, default=0)
    if maximum == 0:
        return ""
    return "".join(SPARK_CHARS[min(int(value / maximum * 7), 7)] for value in values)


def bucket_values(entries: list[dict], value_fn, days: int) -> list[float]:
    end = time.time()
    start = end - days * 86400
    bucket_width = days * 86400 / WEEKS
    values = [0.0] * WEEKS
    for entry in entries:
        index = int((entry["timestamp"] - start) // bucket_width)
        if 0 <= index < WEEKS:
            values[index] += value_fn(entry)
    return values


def format_tokens(value: int) -> str:
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.3g}B"
    if value >= 1_000_000:
        return f"{value / 1_000_000:.3g}M"
    if value >= 1_000:
        return f"{value / 1_000:.3g}k"
    return str(value)


def format_usd(value: float) -> str:
    if value >= 1000:
        return f"${value / 1000:.2g}k"
    if value >= 100:
        return f"${value:.0f}"
    if value >= 10:
        return f"${value:.1f}"
    return f"${value:.2f}"


def main() -> None:
    mode = "tokens" if "--tokens" in sys.argv else "cost"
    try:
        days = int(sys.argv[sys.argv.index("--days") + 1]) if "--days" in sys.argv else DEFAULT_DAYS
    except (ValueError, IndexError):
        return

    entries = load_sessions(days)
    if mode == "cost":
        pricing = load_pricing()
        for entry in entries:
            if entry["agent"] == "claude":
                cost = claude_cost(pricing, entry)
                if cost is not None:
                    entry["cost_usd"] = cost
                    entry["cost_known"] = True
        priced_entries = [
            entry for entry in entries
            if entry.get("cost_known", entry["agent"] == "pi")
        ]
        unpriced_count = len(entries) - len(priced_entries)
        total = sum(entry["cost_usd"] for entry in priced_entries)
        values = bucket_values(priced_entries, lambda entry: entry["cost_usd"], days)
        label = f"~{format_usd(total)} est"
        if unpriced_count:
            label += " +?"
    else:
        total = sum(entry["input_tokens"] + entry["output_tokens"] for entry in entries)
        values = bucket_values(entries, lambda entry: entry["input_tokens"] + entry["output_tokens"], days)
        label = f"{format_tokens(total)} tok"

    if entries:
        print(f"{sparkline(values)} {label}")


if __name__ == "__main__":
    main()
