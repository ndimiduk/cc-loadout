#!/usr/bin/env python3
"""Snapshot and restore tmux sessions hosting Claude Code sessions.

`snapshot` records each tmux session and window, and the Claude session running
in it, so `restore` can rebuild the layout and resume every conversation after
a restart or crash. Snapshots are triggered by tmux hooks and a Claude
SessionStart hook rather than polling; see tools/README.md.
"""

from __future__ import annotations

import argparse
import datetime
import fcntl
import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HISTORY_KEEP = 20
RESTORE_QUIET_SECONDS = 120
SEP = "\t"
PANE_FIELDS = [
    "session_name",
    "window_index",
    "window_id",
    "window_name",
    "window_active",
    "automatic-rename",
    "pane_id",
    "pane_pid",
    "pane_active",
    "pane_current_path",
]


def state_dir() -> Path:
    if os.environ.get("CC_RESTORE_DIR"):
        return Path(os.environ["CC_RESTORE_DIR"])
    base = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(base) / "cc-loadout" / "tmux-restore"


def tmux_cmd(socket: str | None) -> list[str]:
    return ["tmux", "-L", socket] if socket else ["tmux"]


def run(cmd: list[str]) -> str:
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def claude_bin() -> str:
    found = shutil.which("claude") or "/opt/homebrew/bin/claude"
    if not os.path.exists(found):
        raise RuntimeError("claude binary not found")
    return found


def interactive_claude_sessions() -> list[dict]:
    """Live interactive sessions from `claude agents --json`; raises if unavailable."""
    agents = json.loads(run([claude_bin(), "agents", "--json"]))
    return [a for a in agents if a.get("kind") == "interactive" and a.get("pid")]


def process_table() -> tuple[dict[int, int], dict[int, str]]:
    parent, args = {}, {}
    for line in run(["ps", "-A", "-o", "pid=,ppid=,args="]).splitlines():
        parts = line.split(None, 2)
        if len(parts) < 2:
            continue
        pid, ppid = int(parts[0]), int(parts[1])
        parent[pid] = ppid
        args[pid] = parts[2] if len(parts) > 2 else ""
    return parent, args


def model_from_args(argv: str) -> str | None:
    tokens = argv.split()
    for i, tok in enumerate(tokens):
        if tok == "--model" and i + 1 < len(tokens):
            return tokens[i + 1]
        if tok.startswith("--model="):
            return tok.split("=", 1)[1]
    return None


def list_panes(socket: str | None) -> list[dict]:
    fmt = SEP.join("#{" + f + "}" for f in PANE_FIELDS)
    panes = []
    for line in run(tmux_cmd(socket) + ["list-panes", "-a", "-F", fmt]).splitlines():
        values = line.split(SEP)
        if len(values) == len(PANE_FIELDS):
            panes.append(dict(zip(PANE_FIELDS, values)))
    return panes


def server_identity(socket: str | None) -> str:
    # Window ids restart at @0 with each server, so they only identify a window
    # across snapshots taken from the same server.
    return run(tmux_cmd(socket) + ["display", "-p", "#{pid}:#{start_time}"]).strip()


def carried_claude(previous: dict | None, server: str) -> dict[str, dict]:
    """Claude sessions from the previous snapshot of this server, by window id."""
    if not previous or previous.get("server") != server:
        return {}
    return {
        w["id"]: w["claude"]
        for s in previous.get("sessions", [])
        for w in s["windows"]
        if w.get("id") and w.get("claude")
    }


def take_snapshot(socket: str | None, previous: dict | None = None) -> dict:
    server = server_identity(socket)
    # A window whose Claude process has exited keeps its last session: during a
    # shutdown, Claude often exits before its window closes, and the snapshot
    # must still resume it. A window that closes drops out.
    carried = carried_claude(previous, server)
    panes = list_panes(socket)
    parent, args = process_table()
    pane_by_pid = {int(p["pane_pid"]): p for p in panes}

    claude_by_pane = {}
    for session in interactive_claude_sessions():
        pid = session["pid"]
        walk = pid
        while walk > 1 and walk not in pane_by_pid:
            walk = parent.get(walk, 1)
        if walk in pane_by_pid:
            claude_by_pane[pane_by_pid[walk]["pane_id"]] = {
                "session_id": session["sessionId"],
                "name": session.get("name"),
                "cwd": session.get("cwd"),
                "model": model_from_args(args.get(pid, "")),
            }

    windows: dict[tuple[str, int], dict] = {}
    for p in panes:
        key = (p["session_name"], int(p["window_index"]))
        claude = claude_by_pane.get(p["pane_id"])
        current = windows.get(key)
        # One entry per window: prefer the pane running Claude, then the active pane.
        if current and (current["claude"] or (not claude and p["pane_active"] != "1")):
            continue
        windows[key] = {
            "id": p["window_id"],
            "index": key[1],
            "name": p["window_name"],
            "active": p["window_active"] == "1",
            "automatic_rename": p["automatic-rename"] == "1",
            "cwd": (claude or {}).get("cwd") or p["pane_current_path"],
            "claude": (
                {k: claude[k] for k in ("session_id", "name", "model")}
                if claude
                else None
            ),
        }

    for window in windows.values():
        if not window["claude"] and window["id"] in carried:
            window["claude"] = carried[window["id"]]

    sessions: dict[str, list[dict]] = {}
    for (session_name, _), window in sorted(windows.items()):
        sessions.setdefault(session_name, []).append(window)
    return {
        "version": 1,
        "server": server,
        "sessions": [{"name": n, "windows": w} for n, w in sessions.items()],
    }


def read_snapshot(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def restore_in_progress(directory: Path) -> bool:
    flag = directory / "restoring"
    try:
        return time.time() - flag.stat().st_mtime < RESTORE_QUIET_SECONDS
    except FileNotFoundError:
        return False


def write_snapshot(directory: Path, snapshot: dict, previous: dict | None) -> bool:
    """Write snapshot.json if its content changed, keeping the old one in history."""
    current = directory / "snapshot.json"
    if previous is not None:
        if {k: v for k, v in previous.items() if k != "taken"} == snapshot:
            return False
        # Copy rather than move, so snapshot.json exists at every moment.
        history = directory / "history"
        history.mkdir(exist_ok=True)
        stamp = datetime.datetime.fromtimestamp(current.stat().st_mtime)
        shutil.copy2(current, history / f"snapshot-{stamp:%Y%m%dT%H%M%S.%f}.json")
        for old in sorted(history.glob("snapshot-*.json"))[:-HISTORY_KEEP]:
            old.unlink()
    record = {**snapshot, "taken": datetime.datetime.now().astimezone().isoformat()}
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".snapshot.")
    with os.fdopen(fd, "w") as f:
        json.dump(record, f, indent=2)
        f.write("\n")
    os.replace(tmp, current)
    return True


def cmd_snapshot(opts) -> int:
    # Runs from tmux and Claude hooks: never print to stdout (tmux `run` shows it
    # in the pane) and always exit 0. Errors go to snapshot.log.
    directory = state_dir()
    try:
        directory.mkdir(parents=True, exist_ok=True)
        with open(directory / "lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if restore_in_progress(directory):
                return 0
            previous = read_snapshot(directory / "snapshot.json")
            snapshot = take_snapshot(opts.socket, previous)
            if not snapshot["sessions"]:
                return 0
            write_snapshot(directory, snapshot, previous)
    except Exception as e:  # noqa: BLE001 - hook context, see above
        try:
            with open(directory / "snapshot.log", "a") as log:
                log.write(f"{datetime.datetime.now().isoformat()} {e!r}\n")
        except OSError:
            pass
    return 0


def snapshot_files(directory: Path) -> list[Path]:
    files = sorted((directory / "history").glob("snapshot-*.json"), reverse=True)
    current = directory / "snapshot.json"
    return ([current] if current.exists() else []) + files


def cmd_list(opts) -> int:
    for path in snapshot_files(state_dir()):
        data = json.loads(path.read_text())
        windows = [w for s in data["sessions"] for w in s["windows"]]
        resumable = sum(1 for w in windows if w["claude"])
        names = ", ".join(s["name"] for s in data["sessions"])
        print(
            f"{path}\n  {data.get('taken', '?')}  {len(data['sessions'])} sessions, "
            f"{len(windows)} windows, {resumable} Claude: {names}"
        )
    return 0


def resume_command(claude: dict) -> str:
    parts = ["claude", "--resume", shlex.quote(claude["session_id"])]
    if claude.get("model"):
        parts += ["--model", shlex.quote(claude["model"])]
    return " ".join(parts)


def cmd_restore(opts) -> int:
    directory = state_dir()
    source = Path(opts.from_file) if opts.from_file else directory / "snapshot.json"
    data = json.loads(source.read_text())
    tmux = tmux_cmd(opts.socket)

    try:
        running = {s["sessionId"] for s in interactive_claude_sessions()}
    except Exception as e:  # noqa: BLE001
        print(f"cannot list running Claude sessions ({e}); refusing to restore", file=sys.stderr)
        return 1
    try:
        existing = set(run(tmux + ["list-sessions", "-F", "#{session_name}"]).split("\n"))
    except subprocess.CalledProcessError:
        existing = set()

    if not opts.dry_run:
        directory.mkdir(parents=True, exist_ok=True)
        (directory / "restoring").touch()

    def execute(cmd: list[str]) -> str:
        if opts.dry_run:
            print(shlex.join(cmd))
            return "<new-window>"
        return run(cmd).strip()

    counts = {"sessions": 0, "windows": 0, "resumed": 0, "running": 0}
    for session in data["sessions"]:
        name = session["name"]
        for window in session["windows"]:
            claude = window["claude"]
            if claude and claude["session_id"] in running:
                counts["running"] += 1
                continue
            create = ["-P", "-F", "#{window_id}", "-n", window["name"], "-c", window["cwd"]]
            if name not in existing:
                window_id = execute(tmux + ["new-session", "-d", "-s", name] + create)
                existing.add(name)
                counts["sessions"] += 1
            else:
                window_id = execute(tmux + ["new-window", "-d", "-t", f"={name}:"] + create)
            counts["windows"] += 1
            # -n turns automatic-rename off; put back what the window had.
            if window["automatic_rename"]:
                execute(tmux + ["set-option", "-w", "-t", window_id, "automatic-rename", "on"])
            if claude:
                execute(tmux + ["send-keys", "-t", window_id, resume_command(claude), "Enter"])
                counts["resumed"] += 1

    prefix = "dry run: " if opts.dry_run else ""
    print(
        f"{prefix}{counts['sessions']} sessions and {counts['windows']} windows created, "
        f"{counts['resumed']} Claude sessions resumed, {counts['running']} skipped (already running)"
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--socket", help="tmux socket name (tmux -L), for testing")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("snapshot", help="record the current layout (run from hooks)")
    sub.add_parser("list", help="show the current snapshot and its history")
    restore = sub.add_parser("restore", help="rebuild the layout and resume Claude sessions")
    restore.add_argument("--from", dest="from_file", help="snapshot file to restore (default: latest)")
    restore.add_argument("--dry-run", action="store_true", help="print the tmux commands instead of running them")
    opts = parser.parse_args()
    return {"snapshot": cmd_snapshot, "list": cmd_list, "restore": cmd_restore}[opts.command](opts)


if __name__ == "__main__":
    sys.exit(main())
